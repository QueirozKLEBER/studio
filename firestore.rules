
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Função auxiliar para verificar se é Staff (Professor ou Admin)
    function isStaff() {
      return request.auth != null && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.userType in ['trainer', 'admin'];
    }

    match /users/{userId} {
      
      // 1. ACESSO DO DONO (Proprietário da conta)
      // O dono tem acesso total ao seu próprio documento de perfil.
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // RECURSIVIDADE PARA O DONO:
      // Garante que o dono possa listar e ler qualquer subcoleção (como appointments, trainingPlans, etc)
      // O wildcard {allPaths=**} resolve o erro de permissão na operação 'list'.
      match /{allPaths=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // 2. ACESSO DE STAFF (Professor ou Admin)
      // Permite que a equipe técnica gerencie os alunos (Listar usuários, Ver perfis).
      allow list, get, update: if isStaff();

      // Permite que a equipe técnica gerencie as subcoleções dos alunos (Treinos, Agendamentos, etc).
      match /{subCollection}/{allSubPaths=**} {
        allow read, write: if isStaff();
      }
      
      // Regra de exclusão: Apenas Admin pode deletar usuários
      allow delete: if request.auth != null && 
                    get(/databases/$(database)/documents/users/$(request.auth.uid)).data.userType == 'admin';
    }

    // Coleções de referência globais (Exercícios e Dicas)
    match /exercises/{exerciseId} {
      allow read: if request.auth != null;
    }

    match /nutritionTips/{nutritionTipId} {
      allow read: if request.auth != null;
    }
  }
}
