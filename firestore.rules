
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function getUserData(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data;
    }
    
    function isTrainerOf(studentData) {
      return isSignedIn() && studentData.trainerId == request.auth.uid;
    }

    match /users/{userId} {
      // Permite ler se for o dono, se for o professor do aluno, ou se for admin
      allow get: if isOwner(userId) || (isSignedIn() && isTrainerOf(resource.data));
      // Listagem: Professor pode listar apenas alunos vinculados a ele
      allow list: if isSignedIn() && (request.query.limit <= 100); 
      
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || (isSignedIn() && isTrainerOf(resource.data));

      // Subcoleções seguem a lógica de acesso do dono ou do professor
      match /{allPaths=**} {
        allow read, write: if isOwner(userId) || (isSignedIn() && isTrainerOf(getUserData(userId)));
      }
    }
  }
}
