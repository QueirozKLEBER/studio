rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * FUNÇÕES AUXILIARES
     */
    function isSignedIn() {
      return request.auth != null;
    }

    // Verifica se o usuário é o dono do registro sem disparar leituras extras
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Busca dados do perfil do usuário logado
    function getAuthData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Verifica cargo específico
    function hasRole(role) {
      return isSignedIn() && getAuthData().userType == role;
    }

    function isStaff() {
      let authData = getAuthData();
      return isSignedIn() && (authData.userType == 'trainer' || authData.userType == 'admin');
    }

    /**
     * REGRAS PARA USUÁRIOS
     */
    match /users/{userId} {
      
      // 1. ACESSO DO DONO (Prioridade Máxima e Absoluta)
      // Permite que o usuário acesse seu próprio perfil e TODAS as subcoleções (appointments, plans, etc)
      // Usamos isSignedIn() direto para evitar loops de get() no próprio documento
      allow read, write: if isOwner(userId);
      
      match /{allPaths=**} {
        allow read, write: if isOwner(userId);
      }

      // 2. ACESSO DA EQUIPE (Staff / Admin)
      // Permite que Staff liste a coleção de usuários
      allow list: if isStaff();
      
      // Permite que Staff leia o perfil de qualquer usuário (especialmente alunos)
      allow get: if isStaff();
      
      // Permite que Staff gerencie as subcoleções de qualquer usuário
      match /{subCollection}/{document=**} {
        allow read, write: if isStaff();
      }
    }

    /**
     * COLEÇÕES GLOBAIS
     */
    match /exercises/{exerciseId} {
      allow read: if isSignedIn();
    }

    match /nutritionTips/{nutritionTipId} {
      allow read: if isSignedIn();
    }
  }
}