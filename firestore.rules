
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Verifica se o usuário logado é o dono do documento
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Helper: Verifica se o usuário logado é o professor do aluno alvo
    function isTrainerOf(studentId) {
      return request.auth != null && get(/databases/$(database)/documents/users/$(studentId)).data.trainerId == request.auth.uid;
    }

    match /users/{userId} {
      // Aluno acessa seu próprio perfil. Professor acessa perfis de seus alunos.
      allow read, write: if isOwner(userId) || isTrainerOf(userId);

      // Subcoleções (Agendamentos, Treinos, Medidas, Histórico)
      match /{allPaths=**} {
        allow read, write: if isOwner(userId) || isTrainerOf(userId);
      }
    }

    // Permitir que professores busquem seus próprios alunos na coleção users
    match /users {
      allow list: if request.auth != null && (
        resource == null || 
        resource.data.trainerId == request.auth.uid || 
        request.auth.uid == resource.id
      );
    }
  }
}
