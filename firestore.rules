
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Função auxiliar para obter os dados do usuário logado com segurança
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Verifica se o usuário não está bloqueado, tratando documentos sem o campo status
    function isNotBlocked() {
      return !isSignedIn() || getUserData().get('status', 'active') != 'blocked';
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId && isNotBlocked();
    }
    
    function isTrainer() {
      return isSignedIn() && getUserData().get('userType', 'student') == 'trainer' && isNotBlocked();
    }

    function isAdmin() {
      return isSignedIn() && getUserData().get('userType', 'student') == 'admin';
    }

    match /users/{userId} {
      // PERMISSÃO CRÍTICA: Permite que o dono do perfil SEMPRE leia seu próprio documento (get).
      // Isso é necessário para que o app identifique o status 'blocked'.
      // Professores e Admins também podem ler qualquer perfil.
      allow get: if isSignedIn() && (request.auth.uid == userId || isTrainer() || isAdmin());
      
      // Listagem (list) continua restrita a quem não está bloqueado ou é admin/trainer
      allow list: if isSignedIn() && (isAdmin() || isTrainer());

      // Apenas o próprio usuário cria seu perfil no signup
      allow create: if isSignedIn() && request.auth.uid == userId;
      
      // Dono (se não bloqueado) ou Admin podem atualizar
      allow update: if isOwner(userId) || isAdmin();
      
      // Apenas Admin deleta
      allow delete: if isAdmin();

      match /trainingPlans/{trainingPlanId} {
        allow get, list: if isSignedIn() && (isOwner(userId) || isTrainer() || isAdmin());
        allow create, update, delete: if isTrainer() || isAdmin();
      }

      match /dietSuggestions/{suggestionId} {
        allow get, list: if isSignedIn() && (isOwner(userId) || isTrainer() || isAdmin());
        allow create, update, delete: if isTrainer() || isAdmin();
      }

      match /workoutHistory/{historyId} {
        allow get, list: if isSignedIn() && (isOwner(userId) || isTrainer() || isAdmin());
        allow create: if isOwner(userId);
      }

      match /bodyMeasurements/{measurementId} {
        allow get, list: if isSignedIn() && (isOwner(userId) || isTrainer() || isAdmin());
        allow create: if isOwner(userId) || isTrainer() || isAdmin();
        allow delete: if isOwner(userId) || isAdmin();
      }
    }

    match /exercises/{exerciseId} {
      allow read: if isNotBlocked();
      allow write: if isAdmin();
    }

    match /nutritionTips/{nutritionTipId} {
      allow read: if isNotBlocked();
      allow write: if isAdmin();
    }
  }
}
