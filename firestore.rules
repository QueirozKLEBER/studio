
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Helper para verificar tipo de usuário de forma segura
    function isUserType(type) {
      return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.userType == type;
    }

    match /users/{userId} {
      // REGRA DE OURO: O dono sempre pode ler e escrever no seu próprio nó e subcoleções
      // Isso evita recursão e garante que o app funcione mesmo se o perfil estiver incompleto
      allow read, write: if isSignedIn() && request.auth.uid == userId;
      
      // Professores e Admins podem listar e ler perfis de alunos
      allow list, get: if isSignedIn() && (isUserType('trainer') || isUserType('admin'));
      
      // Professores podem atualizar dados de alunos (ex: vincular trainerId)
      allow update: if isSignedIn() && (isUserType('trainer') || isUserType('admin'));
      
      // Apenas Admins podem deletar usuários
      allow delete: if isUserType('admin');

      // Subcoleções (Treinos, Dieta, Histórico, Medidas, Agendamentos)
      match /{allSubcollections=**} {
        // Permite que o dono acesse suas subcoleções
        allow read, write: if isSignedIn() && request.auth.uid == userId;
        
        // Permite que professores e admins gerenciem dados dos alunos
        allow read, write: if isSignedIn() && (isUserType('trainer') || isUserType('admin'));
      }
    }

    // Coleções globais de referência
    match /exercises/{exerciseId} {
      allow read: if isSignedIn();
      allow write: if isUserType('admin');
    }

    match /nutritionTips/{nutritionTipId} {
      allow read: if isSignedIn();
      allow write: if isUserType('admin');
    }
  }
}
