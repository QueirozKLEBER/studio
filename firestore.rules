rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * FUNÇÕES AUXILIARES
     */
    function isSignedIn() {
      return request.auth != null;
    }

    // Verifica se o usuário é o dono do caminho pelo UID (Sem recursão)
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Busca o cargo do usuário logado no Firestore
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isStaff() {
      let data = getUserData();
      return isSignedIn() && (data.userType == 'trainer' || data.userType == 'admin');
    }

    function isAdmin() {
      return isSignedIn() && getUserData().userType == 'admin';
    }

    /**
     * REGRAS PARA USUÁRIOS E SUBCOLEÇÕES
     */
    match /users/{userId} {
      
      // 1. ACESSO DO DONO (Prioridade Máxima)
      // Permite leitura e escrita total em seu próprio documento e TODAS as subcoleções (recursivo)
      allow read, write: if isOwner(userId);
      
      match /{allPaths=**} {
        allow read, write: if isOwner(userId);
      }

      // 2. ACESSO DA EQUIPE (Staff / Admin)
      // Permite que Staff liste a coleção de usuários e veja detalhes de alunos
      allow get, list: if isStaff();
      
      // Permite que Staff gerencie todas as subcoleções de qualquer usuário (planilhas, dietas, etc)
      match /{subCollection}/{document=**} {
        allow read, write: if isStaff();
      }
    }

    /**
     * COLEÇÕES GLOBAIS
     */
    match /exercises/{exerciseId} {
      allow read: if isSignedIn();
    }

    match /nutritionTips/{nutritionTipId} {
      allow read: if isSignedIn();
    }
  }
}