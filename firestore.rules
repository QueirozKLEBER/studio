
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Regras Simplificadas para Teste e Estabilidade
    match /users/{userId} {
      // 1. O dono da conta tem acesso total ao seu perfil
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // 2. O professor pode listar e ler perfis de alunos que tenham seu trainerId
      // Usamos resource.data para evitar o uso de get() na listagem
      allow get, list: if request.auth != null && resource.data.trainerId == request.auth.uid;

      // 3. Subcoleções (Agendamentos, Treinos, Medidas)
      match /{allPaths=**} {
        // Dono acessa suas subcoleções
        allow read, write: if request.auth != null && request.auth.uid == userId;
        
        // Professor acessa subcoleções dos seus alunos (usa get() no documento pai para validar)
        allow read, write: if request.auth != null && get(/databases/$(database)/documents/users/$(userId)).data.trainerId == request.auth.uid;
      }
    }
  }
}
