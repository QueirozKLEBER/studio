rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Verifica se o usuário é o dono do documento
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Helper: Verifica se o usuário autenticado é o professor do aluno
    function isTrainerOf(studentData) {
      return request.auth != null && studentData.get('trainerId', '') == request.auth.uid;
    }

    match /users/{userId} {
      // O usuário sempre pode ler e editar seu próprio perfil
      // O Professor pode ler e editar o perfil dos seus alunos vinculados
      allow read, write: if isOwner(userId) || isTrainerOf(resource.data);
      
      // Permitir criação de perfil inicial
      allow create: if request.auth != null;

      // Subcoleções (Treinos, Medidas, Histórico, Dieta)
      match /{allPaths=**} {
        allow read, write: if isOwner(userId) || 
          isTrainerOf(get(/databases/$(database)/documents/users/$(userId)).data);
      }
    }

    // Permite que professores listem a coleção users
    // O Firestore aplicará as regras de 'read' de cada documento para filtrar o resultado
    match /users {
      allow list: if request.auth != null;
    }
  }
}