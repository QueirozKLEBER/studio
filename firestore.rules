
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Helper para verificar tipo de usuário
    // O get() aqui é seguro pois a regra de "Perfil próprio" abaixo resolve a leitura do auth.uid
    function isUserType(type) {
      return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('userType', 'student') == type;
    }

    function isNotBlocked() {
      return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('status', 'active') != 'blocked';
    }

    match /users/{userId} {
      // REGRA CRÍTICA: Permite que o usuário leia seu próprio perfil sem verificações extras.
      // Isso impede a recursão infinita quando isUserType() ou isNotBlocked() são chamados.
      allow get: if isSignedIn() && request.auth.uid == userId;
      
      // Professores e Admins podem listar e ler perfis de terceiros
      allow list: if isSignedIn() && (isUserType('trainer') || isUserType('admin'));
      allow get: if isSignedIn() && (isUserType('trainer') || isUserType('admin'));
      
      allow create: if isSignedIn() && request.auth.uid == userId;
      
      allow update: if isSignedIn() && (
        (request.auth.uid == userId && isNotBlocked()) ||
        isUserType('trainer') || 
        isUserType('admin')
      );
      
      allow delete: if isUserType('admin');

      match /trainingPlans/{trainingPlanId} {
        allow read: if isSignedIn() && (request.auth.uid == userId || isUserType('trainer') || isUserType('admin'));
        allow write: if isUserType('trainer') || isUserType('admin');
      }

      match /dietSuggestions/{suggestionId} {
        allow read: if isSignedIn() && (request.auth.uid == userId || isUserType('trainer') || isUserType('admin'));
        allow write: if isUserType('trainer') || isUserType('admin');
      }

      match /workoutHistory/{historyId} {
        allow read: if isSignedIn() && (request.auth.uid == userId || isUserType('trainer') || isUserType('admin'));
        allow create: if isSignedIn() && request.auth.uid == userId && isNotBlocked();
      }

      match /bodyMeasurements/{measurementId} {
        allow read: if isSignedIn() && (request.auth.uid == userId || isUserType('trainer') || isUserType('admin'));
        allow create: if (isSignedIn() && request.auth.uid == userId && isNotBlocked()) || isUserType('trainer') || isUserType('admin');
        allow delete: if isSignedIn() && (request.auth.uid == userId || isUserType('admin'));
      }

      match /appointments/{appointmentId} {
        // Professores gerenciam agendamentos no seu próprio path.
        // Simplificado para garantir que a listagem na Dashboard funcione sem erros de permissão.
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }
    }

    match /exercises/{exerciseId} {
      allow read: if isSignedIn() && isNotBlocked();
      allow write: if isUserType('admin');
    }

    match /nutritionTips/{nutritionTipId} {
      allow read: if isSignedIn() && isNotBlocked();
      allow write: if isUserType('admin');
    }
  }
}
