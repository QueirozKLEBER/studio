
{
  "entities": {
    "User": {
      "title": "User",
      "type": "object",
      "description": "Represents a user of the platform.",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "firstName": { "type": "string" },
        "lastName": { "type": "string" },
        "dateJoined": { "type": "string", "format": "date-time" },
        "userType": { "type": "string", "enum": ["student", "trainer", "admin"] },
        "height": { "type": "string" },
        "weight": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "blocked"], "default": "active" }
      },
      "required": ["id", "email", "firstName", "lastName", "dateJoined", "userType"]
    },
    "TrainingPlan": {
      "title": "TrainingPlan",
      "type": "object",
      "description": "Represents a workout plan assigned to a user.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "userId": { "type": "string" },
        "exercises": { "type": "array", "items": { "type": "object" } },
        "createdAt": { "type": "object" },
        "status": { "type": "string" }
      },
      "required": ["id", "name", "userId", "exercises"]
    },
    "DietSuggestion": {
      "title": "DietSuggestion",
      "type": "object",
      "description": "Nutritional guidance provided by a trainer.",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "meals": { 
          "type": "array", 
          "items": { 
            "type": "object",
            "properties": {
              "time": { "type": "string" },
              "name": { "type": "string" },
              "description": { "type": "string" }
            }
          } 
        },
        "createdAt": { "type": "object" }
      },
      "required": ["id", "title", "description"]
    },
    "WorkoutHistory": {
      "title": "WorkoutHistory",
      "type": "object",
      "description": "Records of completed workouts.",
      "properties": {
        "planId": { "type": "string" },
        "planName": { "type": "string" },
        "completedAt": { "type": "object" },
        "exerciseCount": { "type": "number" },
        "completedExercisesCount": { "type": "number" }
      }
    },
    "BodyMeasurement": {
      "title": "BodyMeasurement",
      "type": "object",
      "description": "Historical record of student physical measurements.",
      "properties": {
        "id": { "type": "string" },
        "weight": { "type": "number" },
        "height": { "type": "number" },
        "bmi": { "type": "number" },
        "createdAt": { "type": "object" }
      },
      "required": ["weight", "height", "bmi", "createdAt"]
    }
  },
  "auth": {
    "providers": ["password", "anonymous"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profiles"
    },
    "/users/{userId}/trainingPlans/{planId}": {
      "schema": { "$ref": "#/entities/TrainingPlan" },
      "description": "Workouts assigned to users"
    },
    "/users/{userId}/dietSuggestions/{suggestionId}": {
      "schema": { "$ref": "#/entities/DietSuggestion" },
      "description": "Dietary guidance for students"
    },
    "/users/{userId}/workoutHistory/{historyId}": {
      "schema": { "$ref": "#/entities/WorkoutHistory" },
      "description": "Records of completed workouts"
    },
    "/users/{userId}/bodyMeasurements/{measurementId}": {
      "schema": { "$ref": "#/entities/BodyMeasurement" },
      "description": "Physical assessment history for evolution tracking"
    }
  }
}
