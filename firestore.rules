
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function getUserData(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data;
    }

    // Verifica se o usuário autenticado não está bloqueado
    function isNotBlocked() {
      let data = getUserData(request.auth.uid);
      return data == null || data.get('status', 'active') != 'blocked';
    }

    // Verificação básica de propriedade
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    // Verifica se o usuário autenticado é um professor
    function isTrainer() {
      return isSignedIn() && getUserData(request.auth.uid).get('userType', 'student') == 'trainer';
    }

    // Verifica se o usuário autenticado é um administrador
    function isAdmin() {
      return isSignedIn() && getUserData(request.auth.uid).get('userType', 'student') == 'admin';
    }

    match /users/{userId} {
      // QUEBRA DE RECURSÃO: 
      // 1. Um usuário sempre pode dar GET no seu próprio perfil (necessário para o app carregar status e tipo)
      // 2. Professores e Admins podem dar GET em qualquer perfil
      allow get: if isSignedIn() && (request.auth.uid == userId || isTrainer() || isAdmin());
      
      // Professores e Admins podem listar a coleção de usuários
      allow list: if isSignedIn() && (isTrainer() || isAdmin());
      
      // Usuários podem criar seu perfil no cadastro
      allow create: if isSignedIn() && request.auth.uid == userId;
      
      // Update: Dono (se não estiver bloqueado), ou Professor/Admin
      allow update: if (isOwner(userId) && isNotBlocked()) || isTrainer() || isAdmin();
      
      // Delete: Apenas Admins
      allow delete: if isAdmin();

      match /trainingPlans/{trainingPlanId} {
        allow get, list: if isSignedIn() && (isOwner(userId) || isTrainer() || isAdmin());
        allow create, update, delete: if isTrainer() || isAdmin();
      }

      match /dietSuggestions/{suggestionId} {
        allow get, list: if isSignedIn() && (isOwner(userId) || isTrainer() || isAdmin());
        allow create, update, delete: if isTrainer() || isAdmin();
      }

      match /workoutHistory/{historyId} {
        allow get, list: if isSignedIn() && (isOwner(userId) || isTrainer() || isAdmin());
        allow create: if isOwner(userId) && isNotBlocked();
      }

      match /bodyMeasurements/{measurementId} {
        allow get, list: if isSignedIn() && (isOwner(userId) || isTrainer() || isAdmin());
        allow create: if (isOwner(userId) && isNotBlocked()) || isTrainer() || isAdmin();
        allow delete: if isOwner(userId) || isAdmin();
      }

      match /appointments/{appointmentId} {
        // O dono (professor) pode gerenciar seus agendamentos
        allow get, list, write: if isOwner(userId) && isNotBlocked();
      }
    }

    match /exercises/{exerciseId} {
      allow read: if isSignedIn() && isNotBlocked();
      allow write: if isAdmin();
    }

    match /nutritionTips/{nutritionTipId} {
      allow read: if isSignedIn() && isNotBlocked();
      allow write: if isAdmin();
    }
  }
}
