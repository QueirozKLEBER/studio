rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * REGRAS PARA USUÁRIOS E SUBCOLEÇÕES
     */
    match /users/{userId} {
      
      // 1. ACESSO DO DONO (Prioridade Absoluta)
      // Permite que o usuário acesse seu próprio perfil e TODAS as subcoleções (appointments, plans, etc)
      // O uso de {allPaths=**} garante que a operação 'list' em subcoleções funcione.
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      match /{allPaths=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // 2. ACESSO DA EQUIPE (Staff / Admin)
      // Funções auxiliares para Staff
      function isSignedIn() {
        return request.auth != null;
      }
      
      function getAuthData() {
        return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      }

      function isStaff() {
        let authData = getAuthData();
        return isSignedIn() && (authData.userType == 'trainer' || authData.userType == 'admin');
      }

      // Permite que Staff liste a coleção de usuários e leia perfis
      allow list: if isStaff();
      allow get: if isStaff();
      
      // Permite que Staff gerencie as subcoleções de outros usuários (especialmente alunos)
      match /{subCollection}/{document=**} {
        allow read, write: if isStaff();
      }
    }

    /**
     * COLEÇÕES GLOBAIS
     */
    match /exercises/{exerciseId} {
      allow read: if request.auth != null;
    }

    match /nutritionTips/{nutritionTipId} {
      allow read: if request.auth != null;
    }
  }
}