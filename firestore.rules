
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * Função para obter o cargo do usuário.
     * Importante: Firestore faz cache de get() dentro da mesma requisição.
     */
    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.userType;
    }

    /**
     * Regras para a coleção de usuários.
     * O wildcard {userId} captura o ID do documento.
     */
    match /users/{userId} {
      
      // REGRA 1: O DONO tem acesso total e imediato.
      // Usamos {allPaths=**} para que esta regra se aplique a TODAS as subcoleções 
      // (appointments, trainingPlans, workoutHistory, etc.) sem precisar de matches extras.
      match /{allPaths=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // REGRA 2: STAFF (Trainer/Admin) pode gerenciar alunos.
      // Esta regra só precisa ser avaliada se o usuário logado NÃO for o dono do perfil.
      allow list, get, update: if request.auth != null 
        && request.auth.uid != userId 
        && getUserRole() in ['trainer', 'admin'];
      
      allow delete: if request.auth != null 
        && request.auth.uid != userId 
        && getUserRole() == 'admin';

      // STAFF também precisa acessar subcoleções dos alunos para montar treinos/dietas.
      match /{subCollection}/{document=**} {
        allow read, write: if request.auth != null 
          && request.auth.uid != userId 
          && getUserRole() in ['trainer', 'admin'];
      }
    }

    // Coleções de referência globais
    match /exercises/{exerciseId} {
      allow read: if request.auth != null;
    }

    match /nutritionTips/{nutritionTipId} {
      allow read: if request.auth != null;
    }
  }
}
