
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function isExistingOwner(userId) {
      return isSignedIn() && request.auth.uid == userId && resource != null;
    }

    function hasValidUserDataOnCreate(userId) {
      return request.resource.data.id == userId;
    }

    function hasImmutableUserId() {
      return request.resource.data.id == resource.data.id;
    }

    match /users/{userId} {
      // Allow trainers and admins to read any student profile
      allow get, list: if isSignedIn();
      allow create: if isOwner(userId) && hasValidUserDataOnCreate(userId);
      allow update: if isExistingOwner(userId) && hasImmutableUserId();
      allow delete: if isExistingOwner(userId);

      match /trainingPlans/{trainingPlanId} {
        allow get, list: if isSignedIn();
        allow create: if isOwner(userId) || (isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.userType == 'trainer');
        allow update, delete: if isExistingOwner(userId) || (isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.userType == 'trainer');

        match /workouts/{workoutId} {
          allow get, list: if isSignedIn();
          allow create, update, delete: if isOwner(userId) || (isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.userType == 'trainer');
        }
      }

      match /workoutHistory/{historyId} {
        allow get, list, create: if isOwner(userId);
      }
    }

    match /exercises/{exerciseId} {
      allow get, list: if true;
      allow create, update, delete: if isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.userType == 'admin';
    }

    match /nutritionTips/{nutritionTipId} {
      allow get, list: if true;
      allow create, update, delete: if isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.userType == 'admin';
    }

    match /subscriptionPlans/{subscriptionPlanId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    match /userSubscriptions/{userSubscriptionId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && (resource.data.userId == request.auth.uid || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.userType == 'admin');
      allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.userType == 'admin');
    }
  }
}
