rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Funções auxiliares
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function getAuthData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isStaff() {
      return isSignedIn() && (getAuthData().userType == 'trainer' || getAuthData().userType == 'admin');
    }

    /**
     * REGRAS PARA USUÁRIOS E SUBCOLEÇÕES
     */
    match /users/{userId} {
      
      // 1. ACESSO DO DONO (Prioridade Máxima e Absoluta)
      // Permite que o usuário acesse seu próprio perfil e TODAS as subcoleções (appointments, trainingPlans, etc)
      // O uso do wildcard recursivo {allPaths=**} é essencial para que a operação 'list' funcione em subcoleções.
      allow read, write: if isOwner(userId);
      
      match /{allPaths=**} {
        allow read, write: if isOwner(userId);
      }

      // 2. ACESSO DA EQUIPE (Staff / Admin)
      // Permite que trainers/admins visualizem perfis e gerenciem dados de alunos
      allow list, get: if isStaff();
      
      match /{subCollection}/{document=**} {
        // Staff pode gerenciar subcoleções de outros usuários (ex: alunos)
        allow read, write: if isStaff();
      }
    }

    /**
     * COLEÇÕES GLOBAIS
     */
    match /exercises/{exerciseId} {
      allow read: if isSignedIn();
    }

    match /nutritionTips/{nutritionTipId} {
      allow read: if isSignedIn();
    }
  }
}