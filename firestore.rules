
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Função para obter o cargo do usuário sem causar loop infinito
    // Só deve ser chamada se o usuário NÃO for o dono do documento sendo acessado
    function getUserType() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.userType;
    }

    match /users/{userId} {
      
      // 1. REGRA DO DONO (Prioridade Total)
      // O usuário tem acesso total a si mesmo e a todas as suas subcoleções (appointments, trainingPlans, etc)
      // O uso de {allPaths=**} garante que a operação 'list' em subcoleções funcione.
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      match /{allPaths=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // 2. REGRA DE STAFF (Para gerenciar ALUNOS)
      // Importante: request.auth.uid != userId garante que não haja recursão ao ler o próprio perfil
      allow list, get, update: if request.auth != null && 
                                request.auth.uid != userId && 
                                getUserType() in ['trainer', 'admin'];

      // Permite que trainers gerenciem subcoleções de alunos (Treinos, Dieta, etc)
      match /{subCollection}/{allSubPaths=**} {
        allow read, write: if request.auth != null && 
                             request.auth.uid != userId && 
                             getUserType() in ['trainer', 'admin'];
      }
      
      // Apenas Admin pode deletar usuários
      allow delete: if request.auth != null && getUserType() == 'admin';
    }

    // Coleções de referência globais
    match /exercises/{exerciseId} {
      allow read: if request.auth != null;
    }

    match /nutritionTips/{nutritionTipId} {
      allow read: if request.auth != null;
    }
  }
}
