rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * REGRA DE TESTE: APENAS O DONO ACESSA SEUS DADOS
     * Permite ler/escrever o próprio perfil e QUALQUER subcoleção (como appointments)
     */
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // Match recursivo para garantir acesso a todas as subcoleções (appointments, treinos, etc)
      match /{allPaths=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    /**
     * COLEÇÕES GLOBAIS (LEITURA APENAS)
     */
    match /exercises/{exerciseId} {
      allow read: if request.auth != null;
    }

    match /nutritionTips/{nutritionTipId} {
      allow read: if request.auth != null;
    }
  }
}