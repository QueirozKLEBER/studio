rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * Funções auxiliares otimizadas para evitar recursão infinita.
     */
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Busca dados do usuário logado. O Firestore cacheia este get() durante a execução.
    function getAuthenticatedData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      return isAuthenticated() && getAuthenticatedData().userType == role;
    }

    /**
     * Regras para a coleção de usuários e suas subcoleções.
     */
    match /users/{userId} {
      
      // REGRA PRIORITÁRIA (Dono): O usuário tem acesso total e imediato a si mesmo.
      // O uso de {allPaths=**} garante que subcoleções como 'appointments' herdem o acesso.
      // Esta regra é validada APENAS pelo UID, evitando recursão (loops de get).
      match /{allPaths=**} {
        allow read, write: if isOwner(userId);
      }

      // REGRA DE LISTAGEM (Staff): Permite que Professores e Admins listem a coleção /users.
      // Essencial para o Dashboard do Professor carregar a lista de alunos.
      allow list: if isAuthenticated() && (hasRole('trainer') || hasRole('admin'));

      // REGRA DE PERFIL (Staff): Permite que Staff veja perfis de outros usuários.
      allow get: if isAuthenticated() && (hasRole('trainer') || hasRole('admin'));

      // REGRA DE GERENCIAMENTO (Staff): Permite gerenciar subcoleções de outros usuários (alunos).
      match /{subCollection}/{document=**} {
        allow read, write: if isAuthenticated() && (hasRole('trainer') || hasRole('admin'));
      }
    }

    /**
     * Coleções globais de referência.
     */
    match /exercises/{exerciseId} {
      allow read: if isAuthenticated();
    }

    match /nutritionTips/{nutritionTipId} {
      allow read: if isAuthenticated();
    }
  }
}