rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * REGRA PARA USUÁRIOS E SUBCOLEÇÕES (APPOINTMENTS, ETC)
     */
    match /users/{userId} {
      
      // 1. ACESSO DO DONO (Prioridade Absoluta)
      // Permite ler/escrever o próprio perfil e QUALQUER subcoleção (incluindo appointments)
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // Match explícito para subcoleções (garante que a operação 'list' funcione)
      match /{allPaths=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    /**
     * ACESSO PARA EQUIPE (STAFF / ADMIN)
     * Permite que professores gerenciem dados de alunos
     */
    match /users/{userId} {
      allow list, get: if request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.userType in ['trainer', 'admin'];
      
      match /{subCollection}/{document=**} {
        allow read, write: if request.auth != null && 
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.userType in ['trainer', 'admin'];
      }
    }

    /**
     * COLEÇÕES GLOBAIS
     */
    match /exercises/{exerciseId} {
      allow read: if request.auth != null;
    }

    match /nutritionTips/{nutritionTipId} {
      allow read: if request.auth != null;
    }
  }
}