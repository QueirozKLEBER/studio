rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Verifica se o usuário é o dono do documento
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId} {
      // O usuário sempre pode ler e editar seu próprio perfil
      allow read, write: if isOwner(userId);

      // O Professor pode ler e editar o perfil dos seus alunos vinculados
      // Usamos resource.data para permitir queries filtradas
      allow read, write: if request.auth != null && 
        (resource != null && resource.data.trainerId == request.auth.uid);

      // Subcoleções (Treinos, Medidas, Histórico)
      match /{allPaths=**} {
        // Acesso para o dono da subcoleção
        allow read, write: if isOwner(userId);
        
        // Acesso para o professor do aluno dono da subcoleção
        // Verificamos o trainerId no documento pai (user)
        allow read, write: if request.auth != null && 
          get(/databases/$(database)/documents/users/$(userId)).data.trainerId == request.auth.uid;
      }
    }

    // Permite que professores listem a coleção users usando o filtro trainerId
    match /users {
      allow list: if request.auth != null && (
        resource.data.trainerId == request.auth.uid || 
        resource.id == request.auth.uid
      );
    }
  }
}