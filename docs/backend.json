
{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userType": { "enum": ["admin", "trainer", "student"] },
        "email": { "type": "string", "format": "email" },
        "fullName": { "type": "string" },
        "firstName": { "type": "string" },
        "lastName": { "type": "string" },
        "phone": { "type": "string" },
        "status": { "enum": ["active", "pending", "blocked", "inactive"] },
        "trainerId": { "type": "string" },
        "paymentDueDate": { "type": "string", "format": "date" },
        "monthlyFee": { "type": "number" },
        "dateJoined": { "type": "string", "format": "date-time" },
        "height": { "type": "string" },
        "weight": { "type": "string" },
        "cref": { "type": "string" },
        "pixKey": { "type": "string" },
        "bio": { "type": "string" }
      },
      "required": ["id", "userType", "email", "status"]
    },
    "Appointment": {
      "title": "Appointment",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "trainerId": { "type": "string" },
        "studentId": { "type": "string" },
        "studentName": { "type": "string" },
        "title": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "time": { "type": "string" },
        "type": { "enum": ["presencial", "online", "avaliacao"] },
        "notes": { "type": "string" }
      }
    }
  },
  "auth": {
    "providers": ["password"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/backend/entities/UserProfile" },
      "description": "Perfis de usuários. Alunos possuem trainerId."
    },
    "/users/{userId}/appointments/{appointmentId}": {
      "schema": { "$ref": "#/backend/entities/Appointment" },
      "description": "Agenda pessoal do professor ou aluno."
    },
    "/users/{userId}/trainingPlans/{planId}": {
      "schema": { "type": "object" },
      "description": "Planilhas de treino do aluno."
    },
    "/users/{userId}/workoutHistory/{logId}": {
      "schema": { "type": "object" },
      "description": "Logs de treinos concluídos."
    },
    "/users/{userId}/bodyMeasurements/{mId}": {
      "schema": { "type": "object" },
      "description": "Histórico de peso e medidas."
    }
  }
}
