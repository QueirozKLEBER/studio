
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Função auxiliar para verificar se o usuário está autenticado
    function isSignedIn() {
      return request.auth != null;
    }

    // Match principal para a árvore de usuários
    match /users/{userId} {
      
      // REGRA DE PROPRIEDADE: O dono do UID tem acesso total a si mesmo
      allow read, write: if isSignedIn() && request.auth.uid == userId;

      // REGRA DE SUBCOLEÇÕES: Libera o acesso recursivo para TODA a árvore do próprio usuário
      // Isso garante que listagens em /appointments, /trainingPlans, etc., funcionem para o dono.
      match /{allSubcollections=**} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }

      // Função para verificar cargo (Trainer ou Admin) para acesso a outros perfis
      function isStaff() {
        return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.userType in ['trainer', 'admin'];
      }

      // Permissões para Professores e Admins gerenciarem dados dos Alunos
      allow list, get: if isSignedIn() && isStaff();
      allow update: if isSignedIn() && isStaff();
      
      // Apenas Admins podem deletar contas
      allow delete: if isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.userType == 'admin';

      // Regras de subcoleção específicas para Staff acessar dados de Alunos
      match /trainingPlans/{planId} { allow read, write: if isSignedIn() && isStaff(); }
      match /dietSuggestions/{id} { allow read, write: if isSignedIn() && isStaff(); }
      match /workoutHistory/{id} { allow read, write: if isSignedIn() && isStaff(); }
      match /bodyMeasurements/{id} { allow read, write: if isSignedIn() && isStaff(); }
      match /appointments/{id} { allow read, write: if isSignedIn() && isStaff(); }
    }

    // Coleções globais de referência
    match /exercises/{exerciseId} {
      allow read: if isSignedIn();
    }

    match /nutritionTips/{nutritionTipId} {
      allow read: if isSignedIn();
    }
  }
}
