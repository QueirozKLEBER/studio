
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Função central para obter o cargo do usuário logado
    function getRole() {
      // O get() aqui disparará a regra 'read' do documento do usuário logado.
      // Como a regra de 'read' para o próprio dono não chama funções, não haverá loop.
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.userType;
    }

    match /users/{userId} {
      
      // 1. REGRA DO DONO: Acesso total ao próprio perfil e subcoleções.
      // O acesso por UID é instantâneo e não dispara outras funções, evitando recursão.
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      match /{allPaths=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // 2. REGRA DE STAFF (Trainer/Admin):
      // Permite listar usuários e gerenciar subcoleções de alunos.
      // O 'userId != request.auth.uid' garante que a função getRole() nunca seja chamada recursivamente para o próprio usuário.
      allow list, get, update: if request.auth != null && 
                                request.auth.uid != userId && 
                                getRole() in ['trainer', 'admin'];

      match /{subCollection}/{allSubPaths=**} {
        allow read, write: if request.auth != null && 
                             request.auth.uid != userId && 
                             getRole() in ['trainer', 'admin'];
      }
      
      // Apenas Admin pode deletar usuários
      allow delete: if request.auth != null && 
                      request.auth.uid != userId && 
                      getRole() == 'admin';
    }

    // Coleções de referência globais
    match /exercises/{exerciseId} {
      allow read: if request.auth != null;
    }

    match /nutritionTips/{nutritionTipId} {
      allow read: if request.auth != null;
    }
  }
}
