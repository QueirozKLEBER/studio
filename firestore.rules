rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * Funções Auxiliares
     */
    function isSignedIn() {
      return request.auth != null;
    }

    // Verifica se o usuário é o dono do caminho (UID match)
    // Importante: Não faz chamadas get() para evitar recursão
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Busca o cargo do usuário no banco de dados
    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.userType;
    }

    function isStaff() {
      return isSignedIn() && (getUserRole() == 'trainer' || getUserRole() == 'admin');
    }

    /**
     * Regras para Usuários e Subcoleções
     */
    match /users/{userId} {
      
      // 1. ACESSO DO DONO (Prioritário)
      // Garante acesso total ao próprio documento e a TODAS as subcoleções (appointments, workouts, etc.)
      // O uso do wildcard recursivo {allPaths=**} permite a operação 'list' em subcoleções.
      allow read, write: if isOwner(userId);
      
      match /{allPaths=**} {
        allow read, write: if isOwner(userId);
      }

      // 2. ACESSO DA EQUIPE (Staff)
      // Permite que Professores e Admins listem a coleção /users para ver alunos
      allow list, get: if isStaff();
      
      // Permite que Staff gerencie dados de qualquer aluno
      match /{subCollection}/{document=**} {
        allow read, write: if isStaff();
      }
    }

    /**
     * Coleções de Referência (Exercícios e Dicas)
     */
    match /exercises/{exerciseId} {
      allow read: if isSignedIn();
    }

    match /nutritionTips/{nutritionTipId} {
      allow read: if isSignedIn();
    }
  }
}