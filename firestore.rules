
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function isExistingOwner(userId) {
      return isSignedIn() && request.auth.uid == userId && resource != null;
    }

    function isTrainer() {
      return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.userType == 'trainer';
    }

    function isAdmin() {
      return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.userType == 'admin';
    }

    match /users/{userId} {
      allow get, list: if isSignedIn();
      allow create: if isOwner(userId);
      allow update, delete: if isOwner(userId) || isAdmin();

      match /trainingPlans/{trainingPlanId} {
        allow get, list: if isSignedIn();
        allow create, update, delete: if isOwner(userId) || isTrainer() || isAdmin();
      }

      match /dietSuggestions/{suggestionId} {
        allow get, list: if isOwner(userId) || isTrainer() || isAdmin();
        allow create, update, delete: if isTrainer() || isAdmin();
      }

      match /workoutHistory/{historyId} {
        allow get, list: if isOwner(userId) || isTrainer() || isAdmin();
        allow create: if isOwner(userId);
      }

      match /bodyMeasurements/{measurementId} {
        allow get, list, create: if isOwner(userId) || isTrainer() || isAdmin();
        allow delete: if isOwner(userId) || isAdmin();
      }
    }

    match /exercises/{exerciseId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /nutritionTips/{nutritionTipId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
